<?xml version="1.0" encoding="UTF-8"?>
<!--
  ログの設定（自動生成 / auto-generated）。
  テンプレート（spring/src/main/resources/logback-spring.xml.tmpl）から生成されました。変更する場合はテンプレートを変更してください。
  出力先・レベルは application.properties の LOG_DIR_APP / LOG_LEVEL_APP / LOG_DIR_JDBC / LOG_LEVEL_JDBC で変更できる。
-->
<configuration>
    <!-- Spring Boot 標準のログの書式（CONSOLE_LOG_PATTERN / FILE_LOG_PATTERN） -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="LOG_DIR_APP" source="LOG_DIR_APP" defaultValue="C:/logs/app.log"/>
    <springProperty scope="context" name="LOG_LEVEL_APP" source="LOG_LEVEL_APP" defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_DIR_JDBC" source="LOG_DIR_JDBC" defaultValue="C:/logs/JDBC.log"/>
    <springProperty scope="context" name="LOG_LEVEL_JDBC" source="LOG_LEVEL_JDBC" defaultValue="INFO"/>

    <!-- コンソール -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- アプリのログファイル（LOG_DIR_APP） -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR_APP}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR_APP}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- DB のログファイル（LOG_DIR_JDBC） -->
    <appender name="JDBC_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR_JDBC}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR_JDBC}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- DB のログ：JDBC_FILE だけに出力（アプリのログには出さない） -->
    <logger name="org.springframework.jdbc" level="${LOG_LEVEL_JDBC}" additivity="false">
        <appender-ref ref="JDBC_FILE"/>
    </logger>
    <logger name="org.hibernate.SQL" level="${LOG_LEVEL_JDBC}" additivity="false">
        <appender-ref ref="JDBC_FILE"/>
    </logger>
    <logger name="org.hibernate.orm.jdbc.bind" level="${LOG_LEVEL_JDBC}" additivity="false">
        <appender-ref ref="JDBC_FILE"/>
    </logger>

    <!-- アプリのログ -->
    <root level="${LOG_LEVEL_APP}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
</configuration>
