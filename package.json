{
  "name": "cem-system",
  "version": "1.0.0",
  "private": true,
  "description": "CEM システムの画面スタイル（Tailwind CSS）",
  "scripts": {
    "css:build": "tailwindcss -i ./src/main/frontend/tailwind.css -o ./src/main/resources/static/css/app.css --minify",
    "css:dev": "tailwindcss -i ./src/main/frontend/tailwind.css -o ./src/main/resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
